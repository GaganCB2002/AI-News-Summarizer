# =============================================================================
# BrieflyAI - Docker Compose Root Environment Configuration
# =============================================================================
# Copy this file to .env and adjust values for your environment.
#   cp .env.example .env
# =============================================================================

# These variables are passed to the Docker containers.
# Backend-specific settings should go in backend/.env

# ---- Backend Configuration ----
DATABASE_URL=sqlite+aiosqlite:///./ai_news.db
JWT_SECRET_KEY=change-this-to-a-long-random-secret-key-in-production
SUMMARY_PROVIDER=ollama
GEMINI_API_KEY=
NEWS_API_KEY_GNEWS=
