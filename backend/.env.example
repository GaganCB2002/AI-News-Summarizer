# =============================================================================
# BrieflyAI - Backend Environment Configuration
# =============================================================================
# Copy this file to .env and adjust values for your environment.
#   cp .env.example .env
# =============================================================================

# ---- Application ----
APP_NAME=AI News Summarizer
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=development
LOG_LEVEL=INFO

# ---- Database ----
# SQLite (development): sqlite+aiosqlite:///./ai_news.db
# PostgreSQL (production): postgresql+asyncpg://user:pass@localhost:5432/ai_news
DATABASE_URL=sqlite+aiosqlite:///./ai_news.db

# ---- JWT Authentication ----
# Generate a secure random key: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-to-a-long-random-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- CORS ----
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8000

# ---- News API Keys (at least one required) ----
NEWS_API_KEY_GNEWS=
NEWS_API_KEY_NEWSAPI=
NEWS_API_KEY_GUARDIAN=
NEWS_API_KEY_MEDIASTACK=
NEWS_API_KEY_CURRENTS=

# ---- AI Provider Settings ----
# Options: ollama (local, free) | gemini (Google cloud)
SUMMARY_PROVIDER=ollama

# Google Gemini Settings (required if SUMMARY_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_MAX_TOKENS=512

# Ollama Settings (required if SUMMARY_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma2:2b
OLLAMA_TIMEOUT=120

# ---- Optional: Redis/Celery (for background tasks & caching) ----
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ---- Optional: SMTP (for password reset emails) ----
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# ---- Rate Limiting ----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_PERIOD=60
