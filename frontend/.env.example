# =============================================================================
# BrieflyAI - Frontend Environment Configuration
# =============================================================================
# Copy this file to .env and adjust values for your environment.
#   cp .env.example .env
# =============================================================================

# ---- API Base URL ----
# When using Vite dev proxy, leave this commented out (proxy forwards /api -> backend).
# For production builds served without the Vite proxy, set the full backend URL:
# VITE_API_URL=http://localhost:8000/api/v1
# VITE_API_URL=
